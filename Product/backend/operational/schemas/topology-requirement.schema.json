{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chw-navigator.org/schema/gen8/topology-requirement/1.0.0",
  "title": "Source-grounded topology relation requirement",
  "type": "object",
  "required": ["id", "relation", "cardinality", "registry", "subject", "evidence"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "relation": {
      "enum": [
        "contact.responsible-area",
        "patient.assigned-chw",
        "patient.supervising-entity",
        "referral.eligible-facilities"
      ]
    },
    "cardinality": {"enum": ["one", "collection"]},
    "registry": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["quotation", "page"],
        "properties": {
          "quotation": {"type": "string", "minLength": 1},
          "page": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
