{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chw-navigator.org/schema/gen8/lifecycle-definition/1.0.0",
  "title": "Version-pinned episode lifecycle definition",
  "type": "object",
  "required": ["id", "version", "predicate_set_version", "dmn_version", "initial_state", "states", "transitions"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "predicate_set_version": {"type": "string", "minLength": 1},
    "dmn_version": {"type": "string", "minLength": 1},
    "initial_state": {"type": "string", "minLength": 1},
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "terminal"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "terminal": {"type": "boolean"},
          "recovery": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "event_type", "event_category"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "event_type": {"type": "string", "minLength": 1},
          "event_category": {"enum": ["clinical", "timer", "external"]},
          "requires_guard": {"type": "boolean"},
          "guard_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
