{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chw-navigator.org/schema/gen8/topology-lock/1.0.0",
  "title": "Exact topology configuration lock",
  "type": "object",
  "required": ["schema_version", "resolver_version", "topology_package"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "resolver_version": {"type": "string", "minLength": 1},
    "topology_package": {
      "type": "object",
      "required": ["id", "version", "snapshot_id", "content_digest", "schema_digest", "access_policy_digest", "capability_vocabulary_digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "minLength": 1},
        "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "schema_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "access_policy_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "capability_vocabulary_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
