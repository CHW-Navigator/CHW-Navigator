{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CHW Navigator mutable-field conflict policy",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "resolver", "orderingRules", "authorityClasses", "fields"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "conflict-policy.person-administrative" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "resolver": { "const": "canonical.mutable-field-resolver@1.0.0" },
    "orderingRules": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "explicit_supersession",
          "source_authority",
          "authorized_workflow",
          "platform_receipt",
          "stable_event_id"
        ]
      }
    },
    "authorityClasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rank"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field", "fieldClass", "conflictPolicy", "allowedAuthorityClasses"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "fieldClass": {
            "enum": [
              "demographic_identity",
              "contact_information",
              "household_membership",
              "geographic_assignment",
              "care_team_assignment",
              "administrative_status",
              "free_text_note"
            ]
          },
          "conflictPolicy": {
            "enum": ["append_correction", "field_merge", "flag_for_review", "immutable_after_creation"]
          },
          "sameFieldConflictFallback": {
            "enum": ["append_correction", "flag_for_review", "immutable_after_creation"]
          },
          "allowedAuthorityClasses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
