{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chw-navigator.org/contracts/data-dictionary.schema.json",
  "title": "CHW Navigator data dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_digest", "concepts"],
  "properties": {
    "schema_version": {"const": "data-dictionary@1.0.0"},
    "content_digest": {"$ref": "#/$defs/digest"},
    "concepts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/concept"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "reference": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "location"],
      "properties": {"source_id": {"type": "string", "minLength": 1}, "location": {"type": "string", "minLength": 1}}
    },
    "identifier": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "code"],
      "properties": {"system": {"type": "string", "minLength": 1}, "code": {"type": "string", "minLength": 1}}
    },
    "interoperability_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["standard", "resource_type", "path", "code"],
      "properties": {
        "standard": {"type": "string", "minLength": 1},
        "resource_type": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1}
      }
    },
    "concept": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "version", "content_digest", "definition", "identifiers", "value_set",
        "type", "unit", "cardinality", "requiredness", "data_owner_role",
        "retention_policy_ref", "consent_policy_ref", "access_policy_ref",
        "interoperability_mappings", "provenance", "lifecycle_state"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
        "version": {"$ref": "#/$defs/version"},
        "content_digest": {"$ref": "#/$defs/digest"},
        "definition": {"type": "string", "minLength": 1},
        "identifiers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}},
        "value_set": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "type": {"enum": ["boolean", "string", "integer", "decimal", "date", "datetime", "choice"]},
        "unit": {"type": "string", "minLength": 1},
        "cardinality": {"enum": ["required", "optional", "repeated"]},
        "requiredness": {"enum": ["always", "conditional", "optional"]},
        "data_owner_role": {"type": "string", "minLength": 1},
        "retention_policy_ref": {"$ref": "#/$defs/reference"},
        "consent_policy_ref": {"$ref": "#/$defs/reference"},
        "access_policy_ref": {"$ref": "#/$defs/reference"},
        "interoperability_mappings": {"type": "array", "items": {"$ref": "#/$defs/interoperability_mapping"}},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}},
        "lifecycle_state": {"enum": ["candidate", "reviewed", "approved", "retired"]}
      }
    }
  }
}
