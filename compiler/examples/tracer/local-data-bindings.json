{
  "schema_version": "cht-local-data-bindings@1.0.0",
  "target_cht_version": "5.2.0",
  "bindings": {
    "local.person.lmp_date@1.0.0": {
      "semantic_name": "most_recent_lmp_date",
      "description": "Most recent recorded LMP date and observation date for the current contact.",
      "value_type": "string",
      "subject": "current_person",
      "adapter": {"kind": "cht_contact_summary", "path": "most_recent_lmp_date"},
      "available_contexts": ["contact"],
      "freshness": {"policy": "max_age_days", "recorded_at_path": "most_recent_lmp_recorded_at", "max_age_days": 300}
    }
  }
}
